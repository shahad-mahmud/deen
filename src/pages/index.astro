---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
import MtWarning from "../components/MtWarning.astro";
import { loadBooks, type Book } from "../lib/books";
import { byAuthor, recent } from "../lib/home";
import { bnNum } from "../lib/render";

const books = loadBooks();
// Progress is shown only while a book is unfinished.
const progress = (b: Book) => b.translated.size < b.total && `অনুবাদ চলছে · ${bnNum(b.translated.size)}/${bnNum(b.total)} পৃষ্ঠা`;
---
<Base title={SITE}>
  <h1>{SITE}</h1>
  <p>ক্লাসিক্যাল আরবি ইসলামি কিতাবসমূহের বাংলা পাঠ, ব্যক্তিগত অধ্যয়নের জন্য, প্রিয়জনদের সাথে শেয়ার করা হলো।</p>
  <MtWarning />

  <form id="search" class="search" role="search" action="/">
    <label for="q">সব কিতাবে খুঁজুন</label>
    <input id="q" type="search" placeholder="যেমন: নিয়ত, সবর, জান্নাত" autocomplete="off" />
    <p id="search-status" class="note" aria-live="polite"></p>
    <ol id="search-results" class="results"></ol>
  </form>

  <section id="continue" hidden>
    <h2>পড়া চালিয়ে যান</h2>
    <ul class="books"></ul>
  </section>

  <h2>নতুন যোগ হয়েছে</h2>
  <ul class="books">
    {recent(books).map((b) => (
      <li><a href={`/${b.id}/`}>{b.title_bn}</a>{b.author_bn && <small class="note"> — {b.author_bn}</small>}{progress(b) && <span class="tag">{progress(b)}</span>}</li>
    ))}
  </ul>

  <h2>লেখক অনুযায়ী সব কিতাব</h2>
  {byAuthor(books).map((group) => (
    <section class="author">
      <h3>{group[0].author_bn || <span class="ar">{group[0].author}</span>} <small class="note">({bnNum(group.length)})</small></h3>
      <ul class="books">
        {group.map((b) => (
          <li><a href={`/${b.id}/`} data-book={b.id}>{b.title_bn}</a> <span class="ar small">({b.name})</span>{progress(b) && <span class="tag">{progress(b)}</span>}</li>
        ))}
      </ul>
    </section>
  ))}
  <script src="../scripts/home.js"></script>
</Base>
